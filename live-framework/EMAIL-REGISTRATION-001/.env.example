NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sg_email_auth
# Generate at least 32 random bytes; store only in an approved secret manager in production.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE_ME
SMTP_PASS=REPLACE_ME
MAIL_FROM=Simplicity Global <no-reply@simplicityglobal.com>
# Separate read-only administrative API token; generate independently from JWT_SECRET.
SG_EMAIL_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
