        "earnings-read",
        "payout-status-read",
        "settlement-candidate-generation"
      ],
      "apiRegistrationConfigured": false,
      "tenantConsentGranted": false,
      "liveEnabled": false,
      "writeEnabled": false
    },
    {
      "id": "xero-ledger",
      "financialModule": "SG-FIN-001",
      "role": "accounting-system-of-record",
      "observedThrough": "connected-read-only-integration",
      "applicationOAuthConfigured": false,
      "journalPostingEnabled": false,
      "bankReconciliationWriteEnabled": false
    }
  ],
  "bankAccountInventory": {
    "source": "Xero chart of accounts",
    "existingAccountsPreserved": true,
    "payoutDestinationMapped": false,
    "accountDetailsStored": false,
    "newAccountsCreated": false
  }
}
