# Copy to repository-root .env before starting the application profile.
# Local development placeholders only. Replace with approved local test values.
POSTGRES_DB=sg_local
POSTGRES_USER=sg_local
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_ONLY_PASSWORD
# Configure a real test OIDC issuer/JWKS/audience before authenticated API use.
OIDC_ISSUER=https://issuer.example.invalid/
OIDC_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
OIDC_AUDIENCE=sg-live-framework-local
CORS_ORIGINS=http://localhost:5173
